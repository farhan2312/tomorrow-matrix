# ---------------------------------------------------------------------------
# Environment variables for Tomorrow Matrix
#
# Copy this file to `.env` and fill in the values from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
#
# `.env` itself is gitignored (never commit real keys). In production, set
# these same variables in Vercel -> Settings -> Environment Variables.
#
# The VITE_* copies are exposed to the browser at build time (safe: the anon
# key is protected by Row-Level Security). The non-VITE_ copies are read by
# server-side code (SSR + admin routes). Same values, both required.
# ---------------------------------------------------------------------------

# Your project's URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=""
SUPABASE_URL=""

# The "anon" / "publishable" key (public, safe to ship to the browser)
VITE_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_PUBLISHABLE_KEY=""

# The "service_role" key (SECRET — server only, bypasses RLS).
# Used by the admin Supabase client in server routes. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=""

# Optional: the short project ref (the "abcdefgh" part of the URL).
# Not required by the app; included for reference/tooling.
# VITE_SUPABASE_PROJECT_ID=""
# SUPABASE_PROJECT_ID=""

# Admin panel password (server-only; gates /admin). Set in Vercel for prod.
ADMIN_PASSWORD=""
